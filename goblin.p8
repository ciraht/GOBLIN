function colisao(px,py)

	local tl = {x=px+3,y=py+15}
	local br = {x=px+12,y=py+12}
	local flag_solid = 0

	-- colisれこo com tiles sれはlidos
	local c1 = fget(mget(tl.x/8,tl.y/8),flag_solid)
	local c2 = fget(mget(tl.x/8,br.y/8),flag_solid)
	local c3 = fget(mget(br.x/8,tl.y/8),flag_solid)
	local c4 = fget(mget(br.x/8,br.y/8),flag_solid)

	if c1 or c2 or c3 or c4 then
		return true
	end

	-- rio
	if rio_x then
		if px+17 >= rio_x+8 and
		   px <= rio_x+17 and
		   py+17 >= rio_y1 and
		   py <= rio_y2 then
			return true
		end
	end
	
	-- ferraria
	if ferraria_x then
		local fx1 = ferraria_x
		local fy1 = ferraria_y
		local fx2 = ferraria_x + 32
		local fy2 = ferraria_y + 32

		if px+12 > fx1 and
		   px+3 < fx2 and
		   py+15 > fy1 and
		   py+4 < fy2 then
			return true
		end
	end


	-- npcs
	for n in all(npcs) do
		if px+4 < n.x+12 and
		   px+12 > n.x+4 and
		   py+4 < n.y+12 and
		   py+12 > n.y+4 then
			return true
		end
	end
	



	return false
end


function bordadomapa(posx,posy)

  local min_x = 0
  local max_x = 289
  local min_y = 0
  local max_y = 201

  local p1 = posx <= min_x
  local p2 = posx + 15 >= max_x
  local p3 = posy <= min_y
  local p4 = posy + 15 >= max_y

  return p1 or p2 or p3 or p4

end
-->8
function checar_npc_dolado()
  if ladoplayer == nil then return false end

  -- centro do player
  local tx = flr((pos_x + 8) / 8)
  local ty = flr((pos_y + 8) / 8)

  -- 1: cima, 2: direita, 3: baixo, 4: esquerda
  if ladoplayer == 1 then ty -= 1 end
  if ladoplayer == 2 then tx += 1 end
  if ladoplayer == 3 then ty += 1 end
  if ladoplayer == 4 then tx -= 1 end

  -- confere todos os npcs
  for n in all(npcs) do
    local nx = flr((n.x + 8) / 8)
    local ny = flr((n.y + 8) / 8)

    if tx == nx and ty == ny then
      id_npc_dialogo = n.id
      return true
    end
  end

  return false
end
