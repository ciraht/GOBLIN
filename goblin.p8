function inputs()

	if dialog:is_active()
	then return end
	
	if btnp(🅾️) and #dialog.dialog_queue == 0
	then
	 if checar_npc_dolado()
	 then
	   chamardialogos()
	 end
	end

if btn(⬅️)
 then
 	ladoplayer = 4
 	if(bordadomapa(pos_x-1,pos_y) == false)
 	then
 		if(colisao(pos_x-1,pos_y) == false)
 		then
  		pos_x -= 1
  	end
  end
 	spt_atual = frame_lado[flr(frame_atual)]
 	spt_flip = false
 end
 
 if btn(➡️)
 then
  ladoplayer = 2
	 if(bordadomapa(pos_x+1,pos_y) == false)
 		then
 		if(colisao(pos_x+1,pos_y) == false)
 		then
  		pos_x += 1
  	end
  end
  spt_atual = frame_lado[flr(frame_atual)]
  spt_flip = true
 end
 
 if btn(⬆️)
 then
  ladoplayer = 1
	 if(bordadomapa(pos_x,pos_y-1) == false)
 	then
		 if(colisao(pos_x,pos_y-1) == false)
 		then
	  	pos_y -= 1
  	end
  end
  spt_atual = frame_cima[flr(frame_atual)]
 end
 
 if btn(⬇️)
 then
  ladoplayer = 3
	 if(bordadomapa(pos_x,pos_y+1) == false)
 		then
	 		if(colisao(pos_x,pos_y+1) == false)
 			then
  			pos_y += 1
	 		end
	 	end
  spt_atual = frame_baixo[flr(frame_atual)]
 end
end
