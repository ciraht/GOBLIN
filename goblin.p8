	function _init() 
		pos_x = 63
	 pos_y = 63
	 spt_atual = 0
	 spt_flip = false
	 frame_cima = {3,4,3,5}
	 frame_lado = {6,7,6,8}
	 frame_baixo = {0,1,0,2}
	 frame_atual = 0
	 velocidade_anim = .2
		cameraposx = mid(0,pos_x-63+4,168)
	 cameraposy = mid(0,pos_y-63+4,80)
	 dialogando = false
	 ladoplayer = 3 --1 cima \ 2 direita \ 3 baixo \ 4 esquerda
	 id_npc_dialogo = 0
	 
	 npcs = {
	  {
	    id = 1,
	    x = 192,
	    y =170,
	    frames = {21,22,21,22},
	    frame_atual = 1,
	    vel_anim = .05
	  },
	  {
	    id = 2,
	    x = 100,
	    y = 100,
	    frames = {9,10,9,10},
	    frame_atual = 1,
	    vel_anim = .03
	  },
	  {
	    id = 3,
	    x = 248,
	    y = 58,
	    frames = {11,12,13,14,15,11,11,11,11,11},
	    frame_atual = 1,
	    vel_anim = .08
	  },
	  {
	    id = 4,
	    x = 40,
	    y = 42,
	    frames = {16,17,18,16,16},
	    frame_atual = 1,
	    vel_anim = .03
	  },
	  {
	    id = 5,
	    x = 120,
	    y = 40,
	    frames = {19,20,19,20},
	    frame_atual = 1,
	    vel_anim = .05
	  },
	  {
	    id = 6,
	    x = 264,
	    y = 160,
	    frames = {23},
	    frame_atual = 1,
	    vel_anim = .04
	  },

	}
	
	estado_mundo = 1
	 
	end
	
	function _update()
	 --comentario--
	 frame_atual+= velocidade_anim
		if frame_atual>=5
		then
		 frame_atual=1
	 end
	 
		for n in all(npcs) do
	  n.frame_atual += n.vel_anim
	  if n.frame_atual >= #n.frames + 1 then
	    n.frame_atual = 1
	  end
	  n.spr = n.frames[flr(n.frame_atual)]
		end
	
	 inputs()
	 cameraposx = mid(0,pos_x-63+4,168)
	 cameraposy = mid(0,pos_y-63+4,80)
	 dialog.x = cameraposx+ 8
	 dialog.y = cameraposy +97
	 dialog:update()
	 
	end
	function rio(x,y1,y2)
		rio_x = x
		rio_y1 = y1
		rio_y2 = y2
	
		for y=y1,y2,8 do
			spr(({197,243})[flr(time()*4)%2+1],x,y)
			spr(({196,212,198})[flr(time()*4)%3+1],x+8,y)
			spr(({195,213})[flr(time()*4)%2+1],x+16,y)
		end
	end
			
	function telhado(x,y)
		telhado_x = x
		telhado_y = y
	
		spr(228,x,y,2,2)
		spr(230,x+16,y,2,2)
	end
	function ferraria(x,y)
		ferraria_x = x
		ferraria_y = y
	
		spr(140,x,y,4,4)
	end

	function _draw()
		 cls()
	  camera(cameraposx, cameraposy)
	
	  map()
	  rio(10,0,200)
	  ferraria(120,16)
	  
	
		local personagens = {}
		
		for n in all(npcs) do
		  add(personagens, {
		    x = n.x,
		    y = n.y,
		    spr = n.spr
		  })
		end
		
		add(personagens, {
		  x = pos_x,
		  y = pos_y,
		  spr = spt_atual
		})
		
		for i=1,#personagens do
		  for j=i+1,#personagens do
		    if personagens[i].y > personagens[j].y then
		      personagens[i], personagens[j] =
		      personagens[j], personagens[i]
		    end
		  end
		end
		
	for p in all(personagens) do
	  if p.x == pos_x and p.y == pos_y then
	    spr(p.spr, p.x, p.y, 1, 1, spt_flip, false)
	  else
	    spr(p.spr, p.x, p.y, 1, 1, false, false)
	  end
	end
	 telhado(176,136) 
	 telhado(160,64)
	 telhado(224,24)
	 telhado(256,112)
	  if dialog:is_active() then
	    rectfill(cameraposx+2, cameraposy+90, cameraposx+120, cameraposy+120, 0)
	    dialog:draw()
	  end
	
	  camera()
	end
